#. module: rental_coefficient_dynamic_pricing
#: model_terms:ir.ui.view,arch_db:rental_coefficient_dynamic_pricing.rental_dynamic_pricing_table_view_form
msgid ""
"Define date/time periods and their pricing factor as a percentage.\n"
"                                <br/>\n"
"                                <b>100%</b> = no price change.\n"
"                                <b>120%</b> = +20% surcharge (peak season).\n"
"                                <b>80%</b> = -20% discount (low season).\n"
"                                <br/>\n"
"                                Lines within the same table may not overlap.\n"
"                                If a rental period spans multiple lines, a weighted average is calculated.\n"
"                                Uncovered periods default to 100%."
msgstr ""

#. module: rental_coefficient_dynamic_pricing
#: model_terms:ir.ui.view,arch_db:rental_coefficient_dynamic_pricing.rental_coefficient_table_view_form
msgid ""
"Define duration thresholds and their coefficients.\n"
"                                The coefficient acts as a charged-duration multiplier:\n"
"                                the final price = base price per unit × coefficient.\n"
"                                <br/>\n"
"                                Example: base price €20/day, 7-day rental with coefficient 5\n"
"                                → charged price = €20 × 5 = €100."
msgstr ""

#. module: rental_coefficient_dynamic_pricing
#: model_terms:ir.ui.view,arch_db:rental_coefficient_dynamic_pricing.rental_dynamic_pricing_table_view_form
msgid "Determines the time granularity for weighted factor computation."
msgstr ""

