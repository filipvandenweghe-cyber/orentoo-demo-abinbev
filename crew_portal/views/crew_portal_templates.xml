<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Home cards -->
    <template id="crew_portal_home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="after">
            <t t-set="crew_emp" t-value="request.env['hr.employee'].sudo().search(
                [('user_id', '=', request.env.user.id), ('is_crew', '=', True)], limit=1)"/>
            <div t-if="crew_emp" class="o_portal_category row g-2 mt-3" id="crew_portal_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My Availability</t>
                    <t t-set="url" t-value="'/my/availability'"/>
                    <t t-set="text">Tell us when you can work</t>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="icon" t-value="'/crew_portal/static/src/img/availability.png'"/>
                    <t t-set="placeholder_count" t-value="'crew_availability_count'"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My Planning</t>
                    <t t-set="url" t-value="'/my/planning'"/>
                    <t t-set="text">Your upcoming shifts</t>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="icon" t-value="'/crew_portal/static/src/img/planning.png'"/>
                    <t t-set="placeholder_count" t-value="'crew_planning_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <!-- No crew profile -->
    <template id="portal_not_crew" name="Crew: no profile">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <p class="text-muted mt-3">No crew profile is linked to your account.
                    Please contact the planner.</p>
            </div>
        </t>
    </template>

    <!-- My Availability -->
    <template id="portal_my_availability" name="My Availability">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <h3 class="mt-3">My Availability</h3>

                <t t-if="inv_rows">
                    <h5 class="mt-4">Open availability requests</h5>
                    <t t-foreach="inv_rows" t-as="inv">
                        <div class="card mb-2"><div class="card-body">
                            <h5 class="card-title mb-1" t-out="inv['header']"/>
                            <div class="text-muted small">Posted at <t t-out="inv['posted']"/></div>
                            <div t-if="inv['period']" class="mt-1">Requested availability
                                <t t-out="inv['period']"/></div>
                            <div t-if="inv['indicative_hours']" class="text-muted">
                                Indicative effort: ~<t t-out="inv['indicative_hours']"/> h
                            </div>
                            <div class="alert alert-warning mt-2 mb-2 py-1">
                                This is only a request for availability — you have not been
                                scheduled yet.
                            </div>
                            <form t-attf-action="/my/invitation/{{inv['id']}}/respond" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" name="response" value="available"
                                        class="btn btn-success btn-sm">I'm available</button>
                                <button type="submit" name="response" value="unavailable"
                                        class="btn btn-secondary btn-sm">Not available</button>
                            </form>
                            <div class="small text-muted mt-2">Planning ID:
                                <t t-out="inv['planning_id']"/></div>
                        </div></div>
                    </t>
                </t>

                <h5 class="mt-4">Register availability</h5>
                <form action="/my/availability/register" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-auto">
                        <label class="col-form-label">From</label>
                    </div>
                    <div class="col-auto">
                        <input type="datetime-local" name="date_start" class="form-control" required="required"/>
                    </div>
                    <div class="col-auto">
                        <label class="col-form-label">To</label>
                    </div>
                    <div class="col-auto">
                        <input type="datetime-local" name="date_end" class="form-control" required="required"/>
                    </div>
                    <div class="col-auto">
                        <select name="state" class="form-select">
                            <option value="available">Available</option>
                            <option value="unavailable">Unavailable</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>

                <h5 class="mt-4">My availability</h5>
                <table class="table table-sm">
                    <thead><tr><th>From</th><th>To</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                        <t t-foreach="win_rows" t-as="w">
                            <tr>
                                <td t-out="w['start']"/>
                                <td t-out="w['end']"/>
                                <td class="text-end">
                                    <form t-attf-action="/my/availability/window/{{w['id']}}/remove"
                                          method="post" class="m-0">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button type="submit"
                                                class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="not win_rows">
                            <td colspan="3" class="text-muted">No availability registered yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- My Planning -->
    <template id="portal_my_planning" name="My Planning">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <h3 class="mt-3">My Planning</h3>
                <p t-if="not slots" class="text-muted">No upcoming shifts.</p>
                <t t-foreach="slots" t-as="slot">
                    <div class="card mb-2"><div class="card-body">
                        <div>
                            <strong><span t-field="slot.start_datetime"/> →
                                <span t-field="slot.end_datetime"/></strong>
                        </div>
                        <div t-if="slot.project_id">Project: <span t-out="slot.project_id.name"/></div>
                        <div t-if="slot.task_id">Task: <span t-out="slot.task_id.name"/></div>
                        <div t-if="slot.role_id">Role: <span t-out="slot.role_id.name"/></div>
                        <div t-if="slot.crew_unavailable_reported"
                             class="alert alert-warning mt-2 mb-0 py-1">
                            You reported you can no longer work this shift. The planner
                            has been notified.
                        </div>
                        <form t-else="" t-attf-action="/my/planning/{{slot.id}}/cannot-work"
                              method="post" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" name="reason" placeholder="Reason (optional)"
                                   class="form-control form-control-sm mb-1"/>
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                I can no longer work this shift
                            </button>
                        </form>
                    </div></div>
                </t>
            </div>
        </t>
    </template>

</odoo>
