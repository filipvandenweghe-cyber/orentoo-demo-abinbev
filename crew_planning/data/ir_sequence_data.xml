<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_crew_availability_request" model="ir.sequence">
            <field name="name">Crew Availability Request</field>
            <field name="code">crew.availability.request</field>
            <field name="prefix">CAR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_crew_work_declaration" model="ir.sequence">
            <field name="name">Crew Work Declaration</field>
            <field name="code">crew.work.declaration</field>
            <field name="prefix">WD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
