<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- MANDATORY: keep blanket unavailability rolling to today + horizon and
             repair consistency idempotently, so Explicit-Availability crew can
             never become accidentally available when coverage lapses. -->
        <record id="cron_crew_availability_roll" model="ir.cron">
            <field name="name">Crew: roll availability horizon &amp; repair</field>
            <field name="model_id" ref="model_crew_availability_engine"/>
            <field name="state">code</field>
            <field name="code">model.roll_and_repair()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
        </record>
    </data>
</odoo>
