<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A standard-schedule internal employee who also uses the Crew Portal. -->
        <record id="emp_crew_standard" model="hr.employee">
            <field name="name">Casey Rivera (Crew — Standard)</field>
            <field name="is_crew" eval="True"/>
            <field name="crew_availability_mode">standard</field>
        </record>

        <!-- Explicit-Availability crew: unavailable-by-default; on create the engine
             seeds the rolling blanket unavailability on the 24/7 crew calendar. Use
             the "Enter Availability" button (or the portal, later phases) to open
             windows. -->
        <record id="emp_crew_explicit_1" model="hr.employee">
            <field name="name">Jordan Blake (Crew — Explicit)</field>
            <field name="is_crew" eval="True"/>
            <field name="crew_availability_mode">explicit</field>
        </record>
        <record id="emp_crew_explicit_2" model="hr.employee">
            <field name="name">Sam Okafor (Crew — Explicit)</field>
            <field name="is_crew" eval="True"/>
            <field name="crew_availability_mode">explicit</field>
        </record>
    </data>
</odoo>
