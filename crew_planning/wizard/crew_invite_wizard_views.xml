<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crew_invite_wizard_form" model="ir.ui.view">
        <field name="name">crew.invite.wizard.form</field>
        <field name="model">crew.invite.wizard</field>
        <field name="arch" type="xml">
            <form string="Find &amp; Invite Candidates">
                <group>
                    <group>
                        <field name="request_id" readonly="1"/>
                        <field name="next_wave" string="Invitation Wave"/>
                    </group>
                    <group>
                        <field name="channel"/>
                        <field name="exclude_answered"/>
                    </group>
                </group>
                <div class="text-muted">
                    Matching candidates below (already-invited crew are excluded). Tick the ones
                    to invite in this wave, then click <b>Invite Selected</b>. Reminders on
                    existing invitations don't create new ones.
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="availability_mode" readonly="1"/>
                        <field name="work_email" readonly="1"/>
                        <field name="mobile_phone" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_invite_selected" type="object"
                            string="Invite Selected" class="btn-primary"/>
                    <button name="action_select_all" type="object" string="Select All"/>
                    <button name="action_refresh" type="object" string="Refresh"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
