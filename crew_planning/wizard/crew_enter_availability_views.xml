<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crew_enter_availability_form" model="ir.ui.view">
        <field name="name">crew.enter.availability.form</field>
        <field name="model">crew.enter.availability</field>
        <field name="arch" type="xml">
            <form string="Enter Availability">
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="availability_mode" readonly="1"/>
                        <field name="state" widget="radio" options="{'horizontal': True}"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <div class="text-muted" invisible="availability_mode == 'explicit'">
                        This employee uses a Standard Working Schedule; explicit availability
                        does not apply.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" invisible="availability_mode != 'explicit'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
