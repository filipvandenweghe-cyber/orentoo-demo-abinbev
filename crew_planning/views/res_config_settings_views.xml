<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_crew" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crew</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Crew Planning" name="crew_planning">
                    <block title="Explicit-Availability Horizons"
                           id="crew_horizons_setting_container">
                        <setting id="crew_unavailability_horizon_setting"
                                 string="Unavailability Coverage Horizon"
                                 help="How far ahead blanket unavailability is guaranteed for Explicit-Availability crew.">
                            <field name="crew_unavailability_horizon_months"/>
                            <span class="text-muted">months</span>
                        </setting>
                        <setting id="crew_entry_horizon_setting"
                                 string="Availability Entry Horizon"
                                 help="How far ahead a crew member may register availability. Must not exceed the coverage horizon.">
                            <field name="crew_availability_entry_horizon_months"/>
                            <span class="text-muted">months</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
