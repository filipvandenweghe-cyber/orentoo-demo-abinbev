<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crew_availability_log_view_list" model="ir.ui.view">
        <field name="name">crew.availability.log.list</field>
        <field name="model">crew.availability.log</field>
        <field name="arch" type="xml">
            <list string="Availability Log" create="false" edit="false">
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="declared_state" decoration-success="declared_state == 'available'"
                       decoration-danger="declared_state == 'unavailable'" widget="badge"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="origin"/>
                <field name="user_id"/>
                <field name="task_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="crew_availability_log_view_search" model="ir.ui.view">
        <field name="name">crew.availability.log.search</field>
        <field name="model">crew.availability.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="available" string="Available" domain="[('declared_state','=','available')]"/>
                <filter name="unavailable" string="Unavailable" domain="[('declared_state','=','unavailable')]"/>
                <separator/>
                <filter name="g_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                <filter name="g_origin" string="Origin" context="{'group_by':'origin'}"/>
            </search>
        </field>
    </record>

    <record id="action_crew_availability_log" model="ir.actions.act_window">
        <field name="name">Availability Log</field>
        <field name="res_model">crew.availability.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
