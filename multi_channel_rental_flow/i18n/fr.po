#. module: multi_channel_rental_flow
#: model:mail.template,body_html:multi_channel_rental_flow.email_template_dossier_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 14px;\">\n"
"\n"
"    <p>Dear <t t-out=\"object.partner_id.name or 'Customer'\">Customer</t>,</p>\n"
"\n"
"    <p>Your booking <strong><t t-out=\"object.display_name or ''\">RD00001</t></strong>\n"
"       has been confirmed and paid.</p>\n"
"\n"
"    <!-- Order references -->\n"
"    <t t-if=\"object.sale_order_ids\">\n"
"        <p><strong>Order references:</strong></p>\n"
"        <ul>\n"
"            <t t-foreach=\"object.sale_order_ids\" t-as=\"order\">\n"
"                <li>\n"
"                    <t t-out=\"order.name\">S00001</t>\n"
"                    <t t-if=\"order.is_rental_order and order.rental_start_date\">\n"
"                        — Rental\n"
"                        <t t-out=\"format_datetime(order.rental_start_date, dt_format='short')\">01/06/2026 09:00</t>\n"
"                        <t t-if=\"order.rental_return_date\">\n"
"                            to <t t-out=\"format_datetime(order.rental_return_date, dt_format='short')\">01/06/2026 11:00</t>\n"
"                        </t>\n"
"                    </t>\n"
"                </li>\n"
"            </t>\n"
"        </ul>\n"
"    </t>\n"
"\n"
"    <!-- Items summary -->\n"
"    <t t-set=\"active_items\" t-value=\"object.item_ids.filtered(lambda i: i.state != 'cancelled')\"/>\n"
"    <t t-if=\"active_items\">\n"
"        <p><strong>Items:</strong></p>\n"
"        <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n"
"            <tr style=\"background-color: #f5f5f5;\">\n"
"                <th style=\"padding: 8px; text-align: left; border-bottom: 1px solid #ddd;\">Product</th>\n"
"                <th style=\"padding: 8px; text-align: left; border-bottom: 1px solid #ddd;\">Details</th>\n"
"                <th style=\"padding: 8px; text-align: right; border-bottom: 1px solid #ddd;\">Qty</th>\n"
"                <th style=\"padding: 8px; text-align: right; border-bottom: 1px solid #ddd;\">Price</th>\n"
"            </tr>\n"
"            <t t-foreach=\"active_items\" t-as=\"item\">\n"
"                <tr>\n"
"                    <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                        <t t-out=\"item.product_id.display_name\">Product</t>\n"
"                    </td>\n"
"                    <td style=\"padding: 8px; border-bottom: 1px solid #eee;\">\n"
"                        <t t-if=\"item.item_role == 'event_ticket' and item.event_id\">\n"
"                            Event: <t t-out=\"item.event_id.name\">Event</t>\n"
"                            <t t-if=\"item.event_slot_id\">\n"
"                                (<t t-out=\"item.event_slot_id.display_name\">Slot</t>)\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-elif=\"item.slot_id\">\n"
"                            <t t-out=\"item.slot_id.name\">Timeslot</t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"dict(item._fields['item_role'].selection).get(item.item_role, '')\">Rental</t>\n"
"                        </t>\n"
"                    </td>\n"
"                    <td style=\"padding: 8px; text-align: right; border-bottom: 1px solid #eee;\">\n"
"                        <t t-out=\"item.quantity\">1</t>\n"
"                    </td>\n"
"                    <td style=\"padding: 8px; text-align: right; border-bottom: 1px solid #eee;\">\n"
"                        <t t-out=\"format_amount(item.price_subtotal, object.currency_id)\">$ 50.00</t>\n"
"                    </td>\n"
"                </tr>\n"
"            </t>\n"
"            <tr style=\"font-weight: bold;\">\n"
"                <td colspan=\"3\" style=\"padding: 8px; text-align: right; border-top: 2px solid #333;\">Total paid:</td>\n"
"                <td style=\"padding: 8px; text-align: right; border-top: 2px solid #333;\">\n"
"                    <t t-out=\"format_amount(object.amount_total, object.currency_id)\">$ 100.00</t>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </t>\n"
"\n"
"    <!-- Payment info -->\n"
"    <t t-if=\"object.payment_reference\">\n"
"        <p>Payment reference: <strong><t t-out=\"object.payment_reference\">TX-001</t></strong></p>\n"
"    </t>\n"
"\n"
"    <hr/>\n"
"\n"
"    <!-- Kiosk lookup instructions -->\n"
"    <p><strong>Retrieve your tickets at the kiosk:</strong></p>\n"
"    <p>Enter your dossier number <strong><t t-out=\"object.name\">RD00001</t></strong>\n"
"       and your email address\n"
"       <strong><t t-out=\"object.partner_email or object.partner_id.email or ''\">customer@example.com</t></strong>\n"
"       at any kiosk terminal to print your tickets.</p>\n"
"\n"
"    <hr/>\n"
"\n"
"    <p style=\"color: #666; font-size: 12px;\">\n"
"        <em>This dossier groups all your bookings, rental orders\n"
"        and event tickets into a single confirmation.</em>\n"
"    </p>\n"
"\n"
"</div>\n"
"            "
msgstr ""

