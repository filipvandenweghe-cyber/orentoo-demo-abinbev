<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Expire payment-pending dossiers after deadline -->
        <record id="ir_cron_expire_pending_dossiers" model="ir.cron">
            <field name="name">Rental Flow: Expire Pending Dossiers</field>
            <field name="model_id" ref="multi_channel_rental_flow.model_rental_dossier"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_pending_dossiers()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
