<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rental period block on the confirmed Purchase Order PDF -->
    <template id="report_purchaseorder_document_rental"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="o.is_rental_purchase" class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-info mb-0" role="status">
                        <strong>Rental — equipment to be returned to the supplier</strong>
                        <div class="row mt-1">
                            <div class="col-6" t-if="o.rental_start_date">
                                <strong>Rental Start Date:</strong>
                                <span t-field="o.rental_start_date"/>
                            </div>
                            <div class="col-6" t-if="o.rental_return_date">
                                <strong>Rental Return Date:</strong>
                                <span t-field="o.rental_return_date"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Rental period block on the Request for Quotation PDF -->
    <template id="report_purchasequotation_document_rental"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//table[hasclass('table-borderless')]" position="before">
            <div t-if="o.is_rental_purchase" class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-info mb-0" role="status">
                        <strong>Rental — equipment to be returned to the supplier</strong>
                        <div class="row mt-1">
                            <div class="col-6" t-if="o.rental_start_date">
                                <strong>Requested Rental Start:</strong>
                                <span t-field="o.rental_start_date"/>
                            </div>
                            <div class="col-6" t-if="o.rental_return_date">
                                <strong>Requested Rental Return:</strong>
                                <span t-field="o.rental_return_date"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
