<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_rental_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.rental.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add the fallback rental expense account in the Accounting settings -->
            <setting id="default_taxes" position="after">
                <setting id="rental_purchase_expense_account_setting"
                         string="Rental Purchase Expense Account" company_dependent="1"
                         help="Fallback expense account for Rental Purchase vendor bills when the product category has none.">
                    <field name="rental_purchase_expense_account_id"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
