<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_rental_policy" model="ir.ui.view">
        <field name="name">stock.picking.type.form.rental.availability.policy</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general']//group[@name='second']" position="inside">
                <group string="Rental Availability"
                       invisible="code not in ['incoming', 'internal', 'mrp_operation']">
                    <field name="rental_incoming_policy"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
