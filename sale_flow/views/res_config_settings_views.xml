<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sale Flow settings under Sales > Invoicing -->
    <record id="res_config_settings_view_form_sale_flow_general" model="ir.ui.view">
        <field name="name">res.config.settings.form.sale.flow.general</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="inside">
                <setting string="Do not add on Invoice if added by Logistics"
                         help="When enabled, products added by logistics during delivery will NOT be automatically added to the invoice.">
                    <field name="sale_flow_skip_invoice_logistics"/>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Lost/Broken Fee Product under Rental settings -->
    <record id="res_config_settings_view_form_sale_flow" model="ir.ui.view">
        <field name="name">res.config.settings.form.sale.flow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_renting.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_renting']//setting[@name='rental_delay_costs']" position="after">
                <setting string="Default Lost/Broken Fee Product"
                         help="Product used for lost/broken charge invoice lines. Determines tax and accounting behavior.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label string="Fee Product" for="lost_broken_fee_product_id"
                                   class="col-lg-3 o_light_label"/>
                            <field name="lost_broken_fee_product_id"
                                   placeholder="Select a service product"
                                   context="{'default_type': 'service'}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
