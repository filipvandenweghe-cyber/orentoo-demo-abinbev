<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_flow_lost_broken_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.flow.lost.broken.wizard.form</field>
        <field name="model">sale.flow.lost.broken.wizard</field>
        <field name="arch" type="xml">
            <form string="Missing Rental Items">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                <div class="text-muted mb-2">
                    Classify the missing quantities. Every classified unit is
                    scrapped from the rental location; the charged buckets also
                    add a fee to the invoice. Anything left unclassified stays
                    on the backorder for a later return.
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_id" readonly="1"/>
                        <field name="delivered_qty" readonly="1"/>
                        <field name="returned_qty" readonly="1"/>
                        <field name="missing_qty" readonly="1"/>
                        <field name="fully_broken_qty"/>
                        <field name="lost_charged_qty"/>
                        <field name="lost_uncharged_qty"/>
                        <field name="still_expected_qty" readonly="1"/>
                        <field name="broken_lost_unit_price"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
