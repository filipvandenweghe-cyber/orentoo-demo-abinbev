<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Record rules enforcing role-based access to sale.flow.line.

         Business rules:
           * Sales Manager: may change commercial/order lines before logistics validation
           * Warehouse Manager: may change logistics before validation
           * Picker: may execute picking, may not alter commercial flow logic
           * Invoicing user: may decide final invoice quantities/prices

         For now, we keep access rules simple and rely on model-level
         access (ir.model.access) rather than complex record rules.
         Protection against invalid history changes is enforced in the
         service layer (e.g. delivered_qty cannot be reduced).
    -->

    <record id="sale_flow_line_rule_company" model="ir.rule">
        <field name="name">Sale Flow Line: multi-company</field>
        <field name="model_id" ref="model_sale_flow_line"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

</odoo>
